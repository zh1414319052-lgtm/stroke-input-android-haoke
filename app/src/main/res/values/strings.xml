  <!-- CJK strokes: U+31D0, U+31D1, U+31D2, U+31D4, U+31D6 -->
  <string name="stroke_1" translatable="false">㇐</string> <!-- STROKE H -->
  <string name="stroke_2" translatable="false">㇑</string> <!-- STROKE S -->
  <string name="stroke_3" translatable="false">㇒</string> <!-- STROKE P -->
  <string name="stroke_4" translatable="false">㇔</string> <!-- STROKE D -->
  <string name="stroke_5" translatable="false">㇖</string> <!-- STROKE HG -->
  <!-- Wildcard stroke: U+FF0A FULLWIDTH ASTERISK in the stroke sequence bar; key label translatable -->
  <string name="stroke_wildcard" translatable="false">＊</string>
  <string name="display_text__stroke_wildcard">＊</string>
  <!-- Backspace: U+232B ERASE TO THE LEFT -->
  <string name="display_text__backspace" translatable="false">⌫</string>
  <!-- Switch to strokes: U+31D0, U+31D1, U+31D2 -->
  <string name="display_text__switch_to_strokes" translatable="false">
    ㇐㇑㇒
  </string>
  <!-- Comma: U+002C COMMA, U+FF0C FULLWIDTH COMMA -->
  <string name="value_text__qwerty_comma" translatable="false">,</string>
  <string name="value_text__strokes_comma" translatable="false">，</string>
  <!-- Space bar: U+25C0, U+25B6 (triangles) -->
  <string name="display_text__qwerty_space_bar">◀ English ▶</string>
  <string name="display_text__strokes_space_bar">◀ Chinese ▶</string>
  <!-- Full stop: U+002E FULL STOP, U+3002 IDEOGRAPHIC FULL STOP -->
  <string name="value_text__qwerty_full_stop" translatable="false">.</string>
  <string name="value_text__strokes_full_stop" translatable="false">。</string>
  <!-- Enter key "done": U+2713 CHECK MARK -->
  <string name="display_text__done" translatable="false">✓</string>
  <!-- Enter key "go": U+2B95 RIGHTWARDS BLACK ARROW -->
  <string name="display_text__go" translatable="false">⮕</string>
  <!-- Enter key "next": U+2398 NEXT PAGE -->
  <string name="display_text__next" translatable="false">⎘</string>
  <!-- Enter key "previous": U+2397 PREVIOUS PAGE -->
  <string name="display_text__previous" translatable="false">⎗</string>
  <!-- Enter key "search": U+1F50D LEFT-POINTING MAGNIFYING GLASS -->
  <string name="display_text__search" translatable="false">🔍</string>
  <!-- Enter key "send": U+27A4 BLACK RIGHTWARDS ARROWHEAD -->
  <string name="display_text__send" translatable="false">➤</string>
