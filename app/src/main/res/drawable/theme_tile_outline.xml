<?xml version="1.0" encoding="utf-8"?>
<!-- Theme picker tile outline (design/stroke-input-theme-pages.haoke-ui.json): accent when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <solid android:color="#00000000" />
      <stroke android:width="2.5dp" android:color="?attr/settingsAccent" />
      <corners android:radius="@dimen/radius__theme_tile" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#00000000" />
      <stroke android:width="1dp" android:color="?attr/settingsDivider" />
      <corners android:radius="@dimen/radius__theme_tile" />
    </shape>
  </item>
</selector>
