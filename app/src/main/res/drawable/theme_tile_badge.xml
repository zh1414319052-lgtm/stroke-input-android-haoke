<?xml version="1.0" encoding="utf-8"?>
<!-- Theme picker: check badge on the selected tile only -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <layer-list>
      <item>
        <shape android:shape="oval">
          <solid android:color="?attr/settingsAccent" />
        </shape>
      </item>
      <item android:drawable="@drawable/icon_check" android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp" />
    </layer-list>
  </item>
  <item android:drawable="@android:color/transparent" />
</selector>
