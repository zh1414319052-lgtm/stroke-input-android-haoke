<io.github.yawnoc.strokeinput.InputContainer
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_gravity="bottom"
  android:orientation="vertical"
>
  <FrameLayout
    android:id="@+id/main_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
  >
    <LinearLayout
      android:id="@+id/main_input_plane"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:orientation="vertical"
    >
      <View
        android:id="@+id/popup_recess"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height__popup_recess"
      />
      <io.github.yawnoc.strokeinput.StrokeSequenceBar
        android:id="@+id/stroke_sequence_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:textColor="@color/stroke_sequence_bar_text"
        android:textSize="@dimen/font_size__stroke_sequence_bar"
        android:ellipsize="start"
        android:singleLine="true"
        android:background="@drawable/stroke_sequence_bar_background"
        android:layout_marginLeft="@dimen/margin_start__stroke_sequence_bar"
        android:layout_marginBottom="@dimen/margin_bottom__stroke_sequence_bar"
        android:paddingTop="@dimen/padding_top__stroke_sequence_bar"
        android:paddingLeft="@dimen/padding_left__stroke_sequence_bar"
        android:paddingRight="@dimen/padding_right__stroke_sequence_bar"
        android:paddingBottom="@dimen/padding_bottom__stroke_sequence_bar"
        android:theme="@style/Theme.AppCompat"
        tools:ignore="RtlHardcoded"
      />
      <!-- Haoke: candidates, overlaid by a toolbar (quick phrases, handwriting, hide keyboard) while there are none -->
      <FrameLayout
        android:id="@+id/candidates_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
      >
        <io.github.yawnoc.strokeinput.CandidatesView
          android:id="@+id/candidates_view"
          android:layout_width="match_parent"
          android:layout_height="@dimen/height__candidate_button"
          android:background="@color/candidate_button_fill_unpressed"
        />
        <LinearLayout
          android:id="@+id/candidates_toolbar"
          android:layout_width="match_parent"
          android:layout_height="@dimen/height__candidate_button"
          android:orientation="horizontal"
          android:background="@color/candidate_button_fill_unpressed"
          android:visibility="gone"
        >
          <!-- the tools scroll if they do not fit (English labels, large candidates) -->
          <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never"
          >
            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="match_parent"
              android:orientation="horizontal"
            >
              <Button
                style="@style/CandidateButton"
                android:id="@+id/quick_phrases_tool"
                android:textSize="@dimen/font_size__toolbar_button"
                android:textAllCaps="false"
                android:drawableLeft="@drawable/icon_quick_phrases"
                android:drawablePadding="@dimen/padding_drawable__toolbar_button"
                tools:ignore="RtlHardcoded"
              />
              <Button
                style="@style/CandidateButton"
                android:id="@+id/handwriting_tool"
                android:textSize="@dimen/font_size__toolbar_button"
                android:textAllCaps="false"
                android:drawableLeft="@drawable/icon_handwriting"
                android:drawablePadding="@dimen/padding_drawable__toolbar_button"
                tools:ignore="RtlHardcoded"
              />
              <Button
                style="@style/CandidateButton"
                android:id="@+id/voice_tool"
                android:textSize="@dimen/font_size__toolbar_button"
                android:textAllCaps="false"
                android:drawableLeft="@drawable/icon_microphone"
                android:drawablePadding="@dimen/padding_drawable__toolbar_button"
                tools:ignore="RtlHardcoded"
              />
            </LinearLayout>
          </HorizontalScrollView>
          <Button
            style="@style/CandidateButton"
            android:id="@+id/hide_keyboard_tool"
            android:textSize="@dimen/font_size__toolbar_button"
            android:textAllCaps="false"
            android:drawableRight="@drawable/icon_hide_keyboard"
            tools:ignore="RtlHardcoded"
          />
        </LinearLayout>
      </FrameLayout>
      <io.github.yawnoc.strokeinput.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
      />
    </LinearLayout>
    <io.github.yawnoc.strokeinput.KeyPreviewPlane
      android:id="@+id/key_preview_plane"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
    />
    <io.github.yawnoc.strokeinput.HandwritingOverlayView
      android:id="@+id/handwriting_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone"
    />
  </FrameLayout>
  <View
    android:id="@+id/bottom_spacer"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:background="@color/bottom_spacer_fill"
  />
</io.github.yawnoc.strokeinput.InputContainer>
